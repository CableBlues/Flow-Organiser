{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noodle",
  "version": "2.0.0",
  "identifier": "app.noodlestudio.flow",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Noodle — Fokus & Planer",
        "label": "main",
        "width": 1280,
        "height": 840,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "identifier": "app.noodlestudio.flow",
    "shortDescription": "Noodle - Daily Mind Planner & Focus",
    "longDescription": "Intelligent task management, ambient focus soundscapes, and mindful routines.",
    "copyright": "© 2026 Noodle Studio. All rights reserved."
  },
  "plugins": {
    "updater": {
      "pubkey": "SET_PUBLIC_KEY_FROM_TAURI_SIGNER_HERE",
      "endpoints": [
        "https://github.com/CableBlues/Flow-Organiser/releases/latest/download/latest.json"
      ]
    }
  }
}
